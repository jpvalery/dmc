---
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import { repoUrl } from '../lib/release';

const links = [
  ['Features', '#features'],
  ['Sounds', '#sounds'],
  ['Install', '#install'],
  ['GitHub', repoUrl],
];
---

<div class="bg-blood font-mono text-[0.74rem] uppercase tracking-[0.24em] text-bone" aria-hidden="true">
  <div class="wrap flex flex-wrap gap-x-[18px] gap-y-1.5 py-[0.6em]">
    <span>Live at your table</span><span>★</span><span>Every session</span><span>★</span><span>Free entry</span>
  </div>
</div>

<nav class="wrap flex flex-wrap items-center justify-between gap-x-5 gap-y-3 border-b border-line py-[18px]" aria-label="Site">
  <a href="/" class="flex items-center gap-3 font-display text-[2rem] leading-none">
    <Image src={icon} alt="" width={40} height={40} densities={[1, 2]} class="size-10 rounded-lg" />
    DMC
  </a>
  <div class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-[0.76rem] uppercase tracking-[0.12em]">
    {links.map(([label, href]) => <a href={href} class="text-muted transition-colors hover:text-bone">{label}</a>)}
  </div>
</nav>
