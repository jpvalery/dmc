---
import { issuesUrl, releasesUrl, repoUrl } from '../lib/release';
---

<footer class="wrap grid gap-x-8 gap-y-4 border-t-2 border-bone pt-8 pb-14 text-base text-muted min-[620px]:grid-cols-[auto_minmax(0,1fr)]">
  <span class="font-display text-[2.8rem] leading-none text-bone">DMC</span>
  <div class="grid gap-1.5">
    <p>Free and open source under the MIT licence. Made by Jp.</p>
    <p><a href={repoUrl}>GitHub</a> · <a href={releasesUrl}>Releases</a> · <a href={issuesUrl}>Report a bug</a></p>
    <p>Sounds from Tabletop Audio and Turbo Bard. Monster data from Open5e.</p>
    <p class="font-mono text-[0.7rem] tracking-[0.03em]">
      Not affiliated with Wizards of the Coast. D&amp;D and D&amp;D Beyond are trademarks of Wizards of the Coast LLC.
    </p>
  </div>
</footer>
