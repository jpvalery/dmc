---
import '../styles/global.css';
import { downloadUrl, repoUrl } from '../lib/release';

interface Props {
  title: string;
  description: string;
  version: string | null;
}

const { title, description, version } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const structured = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'DMC',
  alternateName: 'Dungeon Master of Ceremonies',
  description,
  applicationCategory: 'GameApplication',
  operatingSystem: 'macOS 15 or later (Apple Silicon)',
  ...(version ? { softwareVersion: version } : {}),
  downloadUrl,
  license: 'https://opensource.org/licenses/MIT',
  codeRepository: repoUrl,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#151017" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DMC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="DMC, Dungeon Master of Ceremonies, in red and bone on black" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
  </head>
  <body>
    <slot />
  </body>
</html>
