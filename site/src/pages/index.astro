---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Stage from '../components/Stage.astro';
import Features from '../components/Features.astro';
import Gallery from '../components/Gallery.astro';
import Macropad from '../components/Macropad.astro';
import Sounds from '../components/Sounds.astro';
import Install from '../components/Install.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import { latestRelease } from '../lib/release';

const release = await latestRelease();
---

<Base
  title="DMC · Dungeon Master of Ceremonies"
  description="A free macOS app for running D&D sessions: layered soundscapes, D&D Beyond, a combat tracker and notes, in one window."
  version={release.version}
>
  <Header />
  <main>
    <Hero release={release} />
    <Stage />
    <Features />
    <Gallery />
    <Macropad />
    <Sounds />
    <Install release={release} />
    <Faq />
  </main>
  <Footer />
</Base>
